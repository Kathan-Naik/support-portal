# Copy to .env and fill in. The server reads this file on start.

# Fireworks key for the debug bot (Pi agent). Without it the portal works and the bot shows a setup note.
FIREWORKS_API_KEY=

# Default Fireworks model id for the bot. Any Fireworks chat model id works; the bot page lists the ones your key can use.
PI_MODEL=accounts/fireworks/models/kimi-k3

# API port. Vite (npm run dev) proxies /api to this port.
PORT=8787

# Context compaction (Pi defaults shown). Lower BOT_CONTEXT_WINDOW to see compaction sooner.
# BOT_CONTEXT_WINDOW=131072
# BOT_KEEP_RECENT_TOKENS=20000
# BOT_RESERVE_TOKENS=16384

# Optional overrides
# DB_PATH=data/portal.db
# SEED_DATA_DIR=seed/data
# SEED_PASSWORD=demo1234
